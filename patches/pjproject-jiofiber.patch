# pjproject patch for JioFiber JUICE — AMR mode-set
#
# Apply on top of JFC-pjproject (github.com/JFC-Group/JFC-pjproject), branch
# jfc-rustone-2.17, at commit bf04f99c0 or later. Apply with:
#   git apply pjproject-jiofiber.patch
#
# That base branch already carries the two RFC 5626 instance-id fixes this patch
# used to include, so only the AMR hunk remains here:
#
#   * +sip.instance UUID shape `<00000000-0000-1000-8000-0000XXXXXXXX>` — now
#     upstream in JFC-pjproject commit 507e1e3a3 (was our hunk #2).
#   * contact_params instance-id accumulation / PJ_ETOOSMALL after N calls — now
#     upstream in JFC-pjproject commit bf04f99c0 (was our hunk #3). Their fix is
#     more complete than our old guard: it appends the instprm when each Contact
#     is built via a helper (acc_contact_instprm) instead of mutating
#     acc->cfg.contact_params, which also fixes a per-call acc->pool leak and the
#     param leaking into UAS/rewritten Contacts.
#
# 1) opencore_amr.c: advertise the AMR `mode-set` in our SDP answer. JUICE fires
#    mid-call re-INVITEs demanding mode-set be echoed; without this, calls drop
#    after ~1-2 min with a misleading "Session released - due to de-registration
#    by user" (cause=500). Not upstream — still required.

diff --git a/pjmedia/src/pjmedia-codec/opencore_amr.c b/pjmedia/src/pjmedia-codec/opencore_amr.c
--- a/pjmedia/src/pjmedia-codec/opencore_amr.c
+++ b/pjmedia/src/pjmedia-codec/opencore_amr.c
@@ -438,9 +438,13 @@ static pj_status_t amr_default_attr( pjmedia_codec_factory *factory,
     attr->setting.plc = 1;

     if (def_config[idx].octet_align) {
-        attr->setting.dec_fmtp.cnt = 1;
+        attr->setting.dec_fmtp.cnt = 2;
         attr->setting.dec_fmtp.param[0].name = pj_str("octet-align");
         attr->setting.dec_fmtp.param[0].val = pj_str("1");
+        /* JioFiber JUICE re-INVITEs demand mode-set echoed; advertise all modes */
+        attr->setting.dec_fmtp.param[1].name = pj_str("mode-set");
+        attr->setting.dec_fmtp.param[1].val = (idx==IDX_AMR_NB)?
+            pj_str("0,1,2,3,4,5,6,7") : pj_str("0,1,2,3,4,5,6,7,8");
     }

     /* Default all other flag bits disabled. */
