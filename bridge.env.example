# Copy to bridge.env and fill in. Sourced by scripts/register.sh.
# Get SIP_* values by running jfc_configure.py with logging (see README §5) — it prints
# realm / username / userpwd from the router. Do NOT commit bridge.env (it has your identity).

# --- Identity (from your JioFiber line, via jfc_configure.py) ---
SIP_PUBLIC_ID="sip:+<CC><NUMBER>@<CIRCLE>.wln.ims.jio.com"   # WITH the + ; <CIRCLE> is your service-area code
SIP_AUTH_USER="<CC><NUMBER>@<CIRCLE>.wln.ims.jio.com"        # NO +
SIP_REALM="<CIRCLE>.wln.ims.jio.com"                         # whatever realm jfc_configure.py reports
REGISTRAR="sip:jiofiber.local.html:5068;transport=tls"       # the router; leave as-is on most JioFiber setups
export SIP_PUBLIC_ID SIP_REALM REGISTRAR

# --- Device identity ---
# Pick a hostname the router has NEVER seen so the first-time OTP whitelisting triggers (see README §5).
DEVICE_HOST="MyJioBridge"
ROUTER_IP="192.168.29.1"          # your JioFiber router's LAN IP

# --- Overlay network (Tailscale/WireGuard between the bridge host and Asterisk) ---
BRIDGE_OVERLAY_IP="100.x.x.x"     # this host's overlay IP
ASTERISK_OVERLAY_IP="100.y.y.y"   # Asterisk's overlay IP

# --- Downstream PBX behavior ---
# Leave 0 for the shipped Asterisk configs (their IVR answers before playing — the
# standards-correct design; see README "IVRs must answer"). Set to 1 ONLY if your PBX
# (e.g. a Grandstream UCM playing an IVR/custom ringtone as early media) sends 183 and
# never answers: the bridge then answers the caller as soon as the PBX sends 183, so the
# caller hears the prompt and the core's ring timer doesn't kill the call. Note this
# starts answer supervision (the caller is charged from the 183).
EARLY_ANSWER=0
export EARLY_ANSWER

# --- Paths (adjust TARGET to your build's triple, e.g. x86_64-unknown-linux-gnu) ---
BASE="/opt/jiofiber-bridge"
BIN="$BASE/pjproject/pjsip-apps/bin/samples/x86_64-unknown-linux-gnu/jio_b2bua"
JFC="$BASE/jfc_configure.py"

# --- Alerting (optional) ---
NTFY_TOPIC=""                     # e.g. https://ntfy.sh/your-unique-random-topic  (empty = no alerts)

# ---- DIRECT-IMS mode (advanced): register straight to the P-CSCF, bypassing JUICE ----
# See DIRECT-IMS.md. Leave DIRECT_IMS unset/0 for the normal JUICE path above.
#DIRECT_IMS=1
#IMS_IMPI=<MSISDN>@<circle>.wln.ims.jio.com       # digest username (no +); recover with scripts/jfv-credfind.py
#IMS_PASSWORD=                                     # static IMS digest password; from jfv-credfind.py (NEVER commit)
#IMS_REALM=<circle>.wln.ims.jio.com                # your line's home domain
#IMS_AOR=sip:+<MSISDN>@<circle>.wln.ims.jio.com    # public identity (AOR)
#PCSCF_V6=                                          # a P-CSCF IPv6 (bare, no brackets) from AAAA of pcscf.<realm>
#PCSCF_PORT=5061
#JIO_LAN_V6=                                        # this host's Jio global IPv6 (ip -6 addr show scope global)
#SIP_LOCAL_PORT=5062
#RTP_LOCAL_PORT=4000
#IMS_REG_EXPIRES=3600
#IMS_UA=JCOW407/JUICEJFV-1.3.32
#IMS_PANI=GPON;PSAPId=+<MSISDN>
#IMS_KEEPALIVE=10
